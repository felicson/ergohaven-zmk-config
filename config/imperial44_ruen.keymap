#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <15 16>;
            layers = <1>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <15 16>;
            layers = <0>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    behaviors {
        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <210>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <19 20 21 22>;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <210>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <13 14 15 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp ESC  &kp Q              &kp W                 &kp E                 &kp R                   &kp T                          &kp Y  &kp U                     &kp I                   &kp O                   &kp P                  &kp BSLH
&kp TAB  &hrm_left LCTRL A  &hrm_left LEFT_GUI S  &hrm_left LEFT_ALT D  &hrm_left LEFT_SHIFT F  &kp G                          &kp H  &hrm_right RIGHT_SHIFT J  &hrm_right RIGHT_ALT K  &hrm_right RIGHT_WIN L  &hrm_right RCTRL SEMI  &kp SINGLE_QUOTE
&trans   &kp Z              &kp X                 &kp C                 &kp V                   &kp B  &kp LBKT     &kp RBKT   &kp N  &kp M                     &kp COMMA               &kp DOT                 &kp QUESTION           &trans
                                                                        &kp LCTRL               &mo 2  &kp SPACE    &kp ENTER  &mo 3  &kp RCTRL
            >;

            display-name = "Base";
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp ESC  &kp RU_CYRILLIC_SHORT_I         &kp RU_CYRILLIC_TSE                  &kp RU_CYRILLIC_U                  &kp RU_CYRILLIC_KA                  &kp RU_CYRILLIC_IE                                                   &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE                   &kp RU_CYRILLIC_SHA                  &kp RU_CYRILLIC_SHCHA                &kp RU_CYRILLIC_ZE                &kp BSLH
&kp TAB  &hrm_left LCTRL RU_CYRILLIC_EF  &hrm_left LEFT_GUI RU_CYRILLIC_YERU  &hrm_left LEFT_ALT RU_CYRILLIC_VE  &hrm_left LEFT_SHIFT RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                                                   &kp RU_CYRILLIC_ER  &hrm_right RIGHT_SHIFT RU_CYRILLIC_O  &hrm_right RIGHT_ALT RU_CYRILLIC_EL  &hrm_right RIGHT_GUI RU_CYRILLIC_DE  &hrm_right RCTRL RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&trans   &kp RU_CYRILLIC_YA              &kp RU_CYRILLIC_CHE                  &kp RU_CYRILLIC_ES                 &kp RU_CYRILLIC_EM                  &kp RU_CYRILLIC_I   &kp RU_CYRILLIC_HA    &kp RU_CYRILLIC_HARD_SIGN  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN             &kp RU_CYRILLIC_BE                   &kp RU_CYRILLIC_YU                   &kp RU_QUESTION                   &kp RSHFT
                                                                                                                 &kp LCTRL                           &mo 2               &kp SPACE             &kp ENTER                  &mo 4               &kp RCTRL
            >;
        };

        nav {
            bindings = <
&trans     &trans  &kp HOME      &kp UP    &kp END        &kp INS                                        &kp PG_UP  &kp N7  &kp N8  &kp N9  &trans        &trans
&trans     &trans  &kp LEFT      &kp DOWN  &kp RIGHT      &kp RET                                        &kp PG_DN  &kp N4  &kp N5  &kp N6  &kp NUMBER_0  &trans
&layer_ru  &trans  &kp LC(LEFT)  &trans    &kp LC(RIGHT)  &kp DEL  &kp PRINTSCREEN    &kp LC(BACKSPACE)  &trans     &kp N1  &kp N2  &kp N3  &trans        &layer_ru
                                           &trans         &trans   &trans             &kp BACKSPACE      &mo 5      &trans
            >;

            display-name = "Nav";
        };

        sym_en {
            bindings = <
&trans  &kp AT    &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                    &kp CARET  &kp LBKT  &kp UNDER  &kp RBKT  &trans    &trans
&trans  &kp BSLH  &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &kp QUESTION
&to_en  &kp HASH  &kp STAR  &kp COLON  &kp FSLH  &trans     &trans    &trans  &trans     &kp PIPE  &kp TILDE  &kp AMPS  &kp DOT   &trans
                                       &trans    &mo 5      &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols";
            bindings = <
&trans  &en AT_SIGN  &en LT        &kp EQUAL     &en GT       &en GRAVE                        &kp CARET       &en LBKT  &kp UNDER    &en RBKT  &trans      &trans
&trans  &kp RU_BSLH  &kp LPAR      &kp MINUS     &kp RPAR     &kp PLUS                         &kp RU_PERCENT  &en LBRC  &kp RU_SEMI  &kp RBRC  &kp EXCL    &kp RU_DOUBLE_QUOTES
&trans  &en HASH     &kp RU_ASTRK  &kp RU_COLON  &kp RU_FSLH  &kp RU_NUMERO  &trans    &trans  &trans          &en PIPE  &en TILDE    &en AMPS  &kp RU_DOT  &trans
                                                 &trans       &mo 5          &trans    &trans  &trans          &trans
            >;
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &kp F20           &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &studio_unlock
&trans       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans
                                      &trans   &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
